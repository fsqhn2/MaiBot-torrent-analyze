{
  "manifest_version": 2,
  "id": "com.fsqhn.torrent-analyze",
  "version": "1.0.1",
  "name": "麦麦验车",
  "description": "把磁力链或种子哈希丢给 whatslink.info，返回种子名称、类型、大小、文件数与截图卡片。支持指令、LLM 工具调用，以及引用/合并转发里的磁链自动识别。",
  "author": {
    "name": "fsqhn",
    "url": "https://github.com/fsqhn2"
  },
  "urls": {
    "repository": "https://github.com/fsqhn2/MaiBot-torrent-analyze",
    "homepage": "https://github.com/fsqhn2/MaiBot-torrent-analyze"
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.4.99"
  },
  "sdk": {
    "min_version": "2.3.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=10.0.0"
    },
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.25.0"
    }
  ],
  "capabilities": [
    "send.text",
    "send.image",
    "config.get"
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.png",
      "fallback": "clipboard-check"
    }
  }
}
